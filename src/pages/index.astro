---
import { parse } from 'yaml';
import cvSource from '../data/cv.yaml?raw';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SEOHead from '../components/SEOHead.astro';
import { cvSchema } from '../types';
import '../styles/global.css';
import '@fontsource/source-sans-3/300.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/400-italic.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';

const cv = cvSchema.parse(parse(cvSource));
const [firstName, ...lastNames] = cv.name.split(' ');
const pageTitle = `${cv.name} · ${cv.role} | TiziClash World`;
const pdfName = `${cv.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-cv.pdf`;
const inlineStyles = `:root { --accent: ${cv.accent}; } @page { @bottom-center { content: "${cv.name} · Curriculum Vitae · " counter(page); } }`;
const displayUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const siteUrl = Astro.site?.toString() || 'https://tiziclash.world';
const currentYear = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <SEOHead cv={cv} pageTitle={pageTitle} />
    <style is:inline set:html={inlineStyles}></style>
  </head>
  <body>
    <main class="page" id="main-content">
      <header class="cv-header">
        <h1><span class="first-name">{firstName}</span> {lastNames.join(' ')}</h1>
        <p class="position">{cv.role}</p>
        <ul class="contact" aria-label="Contact Information">
          <li>{cv.location}</li>
          <li><a href={`mailto:${cv.contact.email}`} aria-label={`Send email to ${cv.contact.email}`}>{cv.contact.email}</a></li>
          <li><a href={cv.contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">{displayUrl(cv.contact.linkedin)}</a></li>
          <li><a href={cv.contact.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">{displayUrl(cv.contact.github)}</a></li>
        </ul>
        <a class="download screen-only" href="/cv.pdf" download={pdfName} aria-label={`Download ${cv.name}'s CV as PDF`}>Download PDF</a>
      </header>

      <section aria-labelledby="section-summary">
        <SectionTitle title="Summary" />
        <p class="detail" id="section-summary">{cv.summary}</p>
      </section>

      <section aria-label="Work Experience">
        <SectionTitle title="Experience" />
        {cv.experience.map((employer) => <ExperienceEntry employer={employer} />)}
      </section>

      <section aria-label="Featured Projects">
        <SectionTitle title="Projects" />
        {cv.projects.map((item) => (
          <div class="project">
            <h3>{item.title}</h3>
            <p class="detail">{item.description}</p>
          </div>
        ))}
      </section>

      <section aria-label="Technical Skills">
        <SectionTitle title="Skills" />
        <dl class="skills">
          {cv.skills.map((group) => <><dt>{group.category}</dt><dd>{group.items}</dd></>)}
        </dl>
      </section>

      <section aria-label="Education">
        <SectionTitle title="Education" />
        {cv.education.map((item) => (
          <div class="entry">
            <div class="entry-heading"><h3>{item.degree}</h3><span class="date">{item.dates}</span></div>
            <p class="subtitle">{item.institution}</p>
            {item.note && <p class="detail">{item.note}</p>}
          </div>
        ))}
      </section>

      <section class="two-col" aria-label="Recognition and Languages">
        <div>
          <SectionTitle title="Recognition" />
          {cv.recognition.map((item) => <div class="entry"><h3>{item.title}</h3><p class="detail">{item.note}</p></div>)}
        </div>
        <div>
          <SectionTitle title="Languages" />
          <p class="detail">{cv.languages}</p>
        </div>
      </section>
    </main>

    <footer class="site-footer screen-only">
      <p>© {currentYear} {cv.name} · <a href={siteUrl}>tiziclash.world</a> · All rights reserved.</p>
    </footer>
  </body>
</html>
