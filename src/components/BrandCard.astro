---
import type { BrandItem } from '../data/brands';
import CopyButton from './CopyButton.astro';

interface Props {
  brand: BrandItem;
  rank?: number;
}

const { brand, rank = brand.rank } = Astro.props;
---

<article class:list={['brand-card', { 'is-featured': brand.featured }]}>
  <div class="card-top">
    <div class="card-identity">
      {rank && (
        <span class:list={['rank-badge', { 'top-1': rank === 1, 'top-3': rank <= 3 }]}>
          TOP {rank}
        </span>
      )}
      <div class="brand-name-wrap">
        <h3 class="brand-title">
          <a href={`/brands/${brand.slug}`} class="brand-title-link">{brand.name}</a>
        </h3>
        <span class="founded-tag">{brand.founded}运营</span>
      </div>
    </div>

    {brand.discountBadge && (
      <span class="discount-pill">{brand.discountBadge}</span>
    )}
  </div>

  <p class="brand-tagline">{brand.tagline}</p>

  <div class="specs-grid">
    <div class="spec-cell">
      <span class="spec-label">线路架构</span>
      <span class="spec-value">{brand.lineType}</span>
    </div>
    <div class="spec-cell">
      <span class="spec-label">起步价格</span>
      <span class="spec-value highlight-price">{brand.startingPrice}</span>
    </div>
    <div class="spec-cell">
      <span class="spec-label">协议类型</span>
      <span class="spec-value">{brand.protocol}</span>
    </div>
    <div class="spec-cell">
      <span class="spec-label">客户端支持</span>
      <span class="spec-value text-ellipsis" title={brand.clientSupport}>{brand.clientSupport}</span>
    </div>
  </div>

  <div class="capabilities-bar">
    <div class="cap-group">
      <span class="cap-title">流媒体:</span>
      <span class="cap-badge ok">Netflix 4K</span>
      <span class="cap-badge ok">Disney+</span>
      <span class="cap-badge ok">TikTok</span>
    </div>
    <div class="cap-group">
      <span class="cap-title">AI模型:</span>
      <span class:list={['cap-badge', brand.aiUnlock.chatgpt === 'supported' ? 'ok' : 'warn']}>
        ChatGPT
      </span>
      <span class:list={['cap-badge', brand.aiUnlock.claude === 'supported' ? 'ok' : 'warn']}>
        Claude
      </span>
    </div>
  </div>

  <div class="card-actions">
    <div class="coupon-action">
      {brand.coupon ? (
        <div class="coupon-box">
          <span class="coupon-hint">优惠码:</span>
          <CopyButton text={brand.coupon} />
        </div>
      ) : (
        <span class="no-coupon">直享官网活动</span>
      )}
    </div>

    <div class="btn-group">
      <a href={`/brands/${brand.slug}`} class="btn-detail">查看实测评测</a>
      <a
        href={brand.url}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="btn-register"
      >
        直达官网开通 &rarr;
      </a>
    </div>
  </div>

  <div class="compliance-note">
    *含推广赞助链接，本站独立测评，不影响您的结算价。数据状态: {brand.dataStatus === 'measured' ? '实验室实测' : '官方发布资料'}
  </div>
</article>

<style>
  .brand-card {
    background: #ffffff;
    border: 1px solid var(--rule, #e5e7eb);
    border-radius: 8px;
    padding: 20px 22px;
    margin-bottom: 20px;
    transition: all 0.2s ease;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .brand-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .brand-card.is-featured {
    border: 2px solid var(--accent, #dc3522);
    background: #fffdfd;
    box-shadow: 0 4px 20px rgba(220, 53, 34, 0.08);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .card-identity {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .rank-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    background: #e2e8f0;
    color: #475569;
    letter-spacing: -0.02em;
  }

  .rank-badge.top-3 {
    background: #fef3c7;
    color: #92400e;
  }

  .rank-badge.top-1 {
    background: var(--accent, #dc3522);
    color: #ffffff;
  }

  .brand-name-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--dark, #111827);
  }

  .brand-title-link {
    color: inherit;
    text-decoration: none;
  }

  .brand-title-link:hover {
    color: var(--accent, #dc3522);
  }

  .founded-tag {
    font-size: 0.72rem;
    color: #64748b;
    background: #f1f5f9;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .discount-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent, #dc3522);
    background: #fef2f2;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid #fecaca;
  }

  .brand-tagline {
    font-size: 0.88rem;
    color: var(--gray, #4b5563);
    margin: 6px 0 14px;
    line-height: 1.5;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    padding: 10px 14px;
    border-radius: 6px;
    margin-bottom: 12px;
  }

  .spec-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-label {
    font-size: 0.7rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .spec-value {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--dark, #1e293b);
  }

  .highlight-price {
    color: var(--accent, #dc3522);
    font-weight: 700;
  }

  .text-ellipsis {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .capabilities-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    font-size: 0.78rem;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f5f9;
  }

  .cap-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cap-title {
    color: #64748b;
    font-size: 0.72rem;
  }

  .cap-badge {
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .cap-badge.ok {
    background: #ecfdf5;
    color: #059669;
  }

  .cap-badge.warn {
    background: #fefce8;
    color: #ca8a04;
  }

  .card-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .coupon-action {
    display: flex;
    align-items: center;
  }

  .coupon-box {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .coupon-hint {
    font-size: 0.75rem;
    color: #64748b;
  }

  .no-coupon {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .btn-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-detail {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--dark, #334155);
    padding: 6px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-detail:hover {
    background: #f1f5f9;
  }

  .btn-register {
    font-size: 0.82rem;
    font-weight: 600;
    color: #ffffff;
    background: var(--accent, #dc3522);
    padding: 6px 16px;
    border-radius: 5px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-register:hover {
    background: #b91c1c;
    box-shadow: 0 2px 8px rgba(220, 53, 34, 0.25);
  }

  .compliance-note {
    font-size: 0.68rem;
    color: #94a3b8;
    margin-top: 10px;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .specs-grid {
      grid-template-columns: 1fr 1fr;
    }
    .card-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-group {
      width: 100%;
      justify-content: space-between;
    }
    .btn-detail, .btn-register {
      flex: 1;
      text-align: center;
    }
  }
</style>
