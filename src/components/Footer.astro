<style>
  .site-main-footer {
    background: #0f172a;
    color: #94a3b8;
    border-top: 1px solid #1e293b;
    padding: 48px 20px 32px;
    margin-top: 40px;
    font-size: 0.85rem;
  }

  .footer-inner {
    max-width: 1040px;
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 32px;
  }

  .footer-brand {
    max-width: 380px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .footer-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--accent, #dc3522);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    border-radius: 6px;
  }

  .logo-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
  }

  .footer-desc {
    line-height: 1.6;
    color: #64748b;
    font-size: 0.82rem;
  }

  .footer-links-grid {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .col-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-col a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: var(--accent, #dc3522);
  }

  .col-text {
    color: #64748b;
    font-size: 0.78rem;
  }

  .footer-disclaimer {
    margin: 24px 0;
    padding: 14px 18px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed #334155;
    border-radius: 6px;
    font-size: 0.76rem;
    line-height: 1.6;
    color: #64748b;
  }

  .footer-disclaimer strong {
    color: #cbd5e1;
  }

  .footer-bottom {
    text-align: center;
    font-size: 0.76rem;
    color: #475569;
    padding-top: 12px;
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
      gap: 24px;
    }
    .footer-links-grid {
      gap: 28px;
    }
  }
</style>
